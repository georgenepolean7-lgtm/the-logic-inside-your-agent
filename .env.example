# Google Gemini API Key for AI Market Analysis
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ========================================================
# MOBILE & WHATSAPP ALERT SETTINGS (Choose any mode)
# ========================================================

# --- Mode 1: No-API-Key Direct WhatsApp (Default / Zero Setup) ---
# Enter your phone with country code (e.g., 91 for India).
# Generates 1-click wa.me direct links & opens browser automatically.
WHATSAPP_PHONE=919876543210

# --- Mode 2: Free Ntfy.sh Instant Mobile Push (Zero Registration) ---
# Free push alerts to Android/iOS via free 'ntfy' app (subscribe to this topic)
NTFY_TOPIC=georg_winning_products_alert

# --- Mode 3A: Green-API (Fast & Automated WhatsApp) ---
# Register free at https://green-api.com & scan QR
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# --- Mode 3B: CallMeBot WhatsApp API (Free) ---
# Add +34 644 59 71 67 to WhatsApp & send "I allow callmebot to send me messages"
WHATSAPP_API_KEY=

# --- Mode 3C: Meta WhatsApp Cloud API (Optional Enterprise Fallback) ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE=

# ========================================================
# SCRAPER CONFIGURATION
# ========================================================
HEADLESS=true
SCRAPER_TIMEOUT=15
REQUEST_DELAY_SECONDS=2

